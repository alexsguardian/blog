---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContentWrapper from '~/components/custom/ContentWrapper.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Guides | Alex\'s Blog',
};

const guideSeries = [
  {
    title: 'Grafana',
    icon: 'tabler:chart-dots-2',
    posts: [
      { title: 'Grafana - Getting Started', href: '/posts/2022/07/22/grafana-gettingstarted' },
      { title: 'Grafana - Deploying InfluxDB and Telegraf', href: '/posts/2022/09/17/grafana-influxdb' },
    ],
    extras: [
      { title: 'Monitoring Your Media Server with Varken [Dev]', href: '/posts/2022/12/04/monitoringmediavarken' },
    ],
  },
  {
    title: 'GitHub Actions',
    icon: 'tabler:brand-github',
    posts: [
      { title: 'GitHub Actions - Automatically Build Docker Containers', href: '/posts/2022/06/12/autoghactionsdocker' },
      { title: 'GitHub Actions - Automating your Docker Builds with Diun', href: '/posts/2022/06/20/autoghactionsdiun' },
      { title: 'GitHub Actions - Automatically Deploy Docker Updates to Cloud Hosts via SSH', href: '/posts/2022/06/25/autoghdeploylinode' },
      { title: 'GitHub Actions - Automatically Build and Release Binaries', href: '/posts/2022/06/30/autoghbinary' },
    ],
    extras: [
      { title: 'Deploying Jekyll on a Linode VM via GitHub Actions', href: '/posts/2022/08/15/deployjekylllinode' },
      { title: 'Using Linode CLI to Update Cloud Firewall Rules in GitHub Actions', href: '/posts/2024/02/25/ghactions-linodecli' },
    ],
  },
];
---

<Layout metadata={metadata}>
  <HeroText
    title="Guides"
    subtitle="Collections of posts I've written to help you get started with various tools and services."
  />

  <ContentWrapper>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
      {
        guideSeries.map(({ title, icon, posts, extras }) => (
          <div class="p-4 rounded-lg border border-gray-200 dark:border-slate-700">
            <div class="flex items-center gap-2 mb-3">
              <Icon name={icon} class="w-5 h-5 shrink-0" />
              <h2 class="text-xl font-bold font-heading">{title}</h2>
            </div>
            <ul class="space-y-2">
              {posts.map(({ title: postTitle, href }) => (
                <li>
                  <a href={href} class="text-sm hover:text-primary hover:underline">
                    {postTitle}
                  </a>
                </li>
              ))}
            </ul>
            {extras && extras.length > 0 && (
              <>
                <p class="text-xs font-bold font-heading uppercase tracking-wide text-muted dark:text-slate-400 mt-4 mb-2">
                  Extras
                </p>
                <ul class="space-y-2">
                  {extras.map(({ title: extraTitle, href }) => (
                    <li>
                      <a href={href} class="text-sm hover:text-primary hover:underline">
                        {extraTitle}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
        ))
      }
    </div>
  </ContentWrapper>
</Layout>
